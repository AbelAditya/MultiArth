# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Redis host. Use "redis" when running via docker-compose (matches the
# `redis` service name below); use "localhost" for a local uv/CLI setup.
REDIS_HOST=localhost

# Storage paths. The Docker image sets these to /data/uploads and /data/work
# (backed by the `app-data` volume in docker-compose.yml) — override here
# only if running outside Docker.
UPLOAD_DIR=/tmp/mannerism/uploads
WORK_DIR=/tmp/mannerism

# MongoDB Atlas connection string, used by `analyze bulk` and the dashboard's
# Browse Corpus tab as the durable store for fully-processed videos (Redis
# remains a 24h-TTL scratch store for whichever job is currently in flight).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=multiarth

# Google Drive API key, used by the dashboard's Bulk Upload tab to download
# a manifest entry's video from its drive_url when no local file is already
# staged (unlike `analyze bulk` from the CLI, which expects pre-staged local
# files). Only needs the Drive API enabled on the Google Cloud project —
# no billing account required. Files must be shared "anyone with the link".
GOOGLE_DRIVE_API_KEY=

# Optional: run SenseVoice (Chinese transcription) remotely instead of
# loading funasr+torch locally — see colab/sensevoice_server.ipynb and
# wikis/Verbal-Worker.md. Leave both unset to keep everything local (the
# default). SENSEVOICE_REMOTE_URL changes every time the notebook is
# re-run, so this needs updating each session it's used.
SENSEVOICE_REMOTE_URL=""
SENSEVOICE_API_KEY="random_secret"

# Optional: run MeTRAbs (gesture/pose) remotely on Colab's GPU instead of
# locally — see colab/gesture_server.ipynb and wikis/Gesture-Worker.md.
# Leave both unset to always use local MeTRAbs (the default). On any
# remote failure, GestureWorker falls back to local MeTRAbs automatically
# for the rest of that job — this isn't a hard requirement once set.
# GESTURE_REMOTE_URL changes every time the notebook is re-run.
GESTURE_REMOTE_URL=""
GESTURE_API_KEY="random_secret"
